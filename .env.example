# Generate independent passwords: openssl rand -hex 24
# Used only when the database has no accounts. Afterwards manage users in the UI.
ADMIN_USERNAME=husband
ADMIN_NAME=Your name
ADMIN_PASSWORD=
PARTNER_USERNAME=wife
PARTNER_NAME=Her name
# Set to bootstrap both accounts, or create her account in You & me after signing in.
PARTNER_PASSWORD=
MQTT_SERVER_PASSWORD=
MQTT_DEVICE_PASSWORD=
DEVICE_ID=uno-r4
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=server
MQTT_PASSWORD=
PORT=3000
DATA_DIR=./data
# Production: your exact HTTPS dashboard origin, no trailing slash.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Optional local Compose port (only binds to loopback).
LOCAL_HTTP_PORT=3000

# Dokploy only: a different hostname from APP_ORIGIN, pointing to your server.
# TLS is automatically issued/renewed by Dokploy's existing Traefik resolver.
MQTT_DOMAIN=mqtt.example.com
# Stock Dokploy defaults; change only if your proxy was customized.
DOKPLOY_NETWORK=dokploy-network
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
MQTT_ROUTER_NAME=mystery-box-mqtt
